{
  "uri": "/pack-and-ship/*",
  "name": "saad-packing-shipping-backend",
  "plugins": {
    "authz-keycloak": {
      "_meta": {
        "disable": false
      },
      "client_id": "apisix",
      "client_secret": "rbEdFmfUZaz7kQPxu5wUhqaoN7pKXApp",
      "discovery": "http://10.0.0.8:8080/realms/master/.well-known/uma2-configuration",
      "lazy_load_paths": true
    },
    "cors": {
      "_meta": {
        "disable": false
      },
      "allow_credential": false,
      "allow_headers": "*",
      "allow_methods": "*",
      "allow_origins": "*",
      "expose_headers": "*",
      "max_age": 5
    },
    "proxy-rewrite": {
      "headers": {
        "apisix-token": "$apisix_token"
      },
      "regex_uri": ["^/pack-and-ship/(.*)$", "/$1"]
    },
    "serverless-pre-function": {
      "functions": [
        "return function() local core = require \"apisix.core\"; local token = os.getenv(\"APISIX_TOKEN\"); if not token then ngx.status = 500; ngx.say('{ \"error\": \"env_missing\", \"error_description\": \"env APISIX_TOKEN not found\" }'); ngx.exit(ngx.HTTP_OK); end core.ctx.register_var(\"apisix-token\", token); end"
      ],
      "phase": "before_proxy"
    }
  },
  "upstream_id": "509865483831346026",
  "status": 1
}
